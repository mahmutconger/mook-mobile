<?xml version="1.0" encoding="utf-8"?>
<!--
    Mook — Data Extraction Rules (Android 12+)
    Excludes all app data from cloud backup and device-to-device transfer.
    User credentials and session data must never leave the device via
    Android backup mechanisms; the user always logs in fresh on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
