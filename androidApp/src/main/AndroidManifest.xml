<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Firebase Auth, Firestore, Storage, and Coil image loading. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Photo picker (ActivityResultContracts.PickVisualMedia) does NOT require
        storage permissions on API 33+. The declarations below are kept only for
        API 24–32 devices where the legacy picker needs READ_EXTERNAL_STORAGE.
        On API 33+ they are ignored by the system.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Package visibility (Android 11+): allows checking whether the companion
        WalkTalk app is installed so "Send Message" can open it, or fall back to
        Google Play when it is not.
    -->
    <queries>
        <package android:name="com.istaps.walktalk2" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mook">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>