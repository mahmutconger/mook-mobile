<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Firebase Auth, Firestore, Storage, and Coil image loading. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Photo picker (ActivityResultContracts.PickVisualMedia) does NOT require
        storage permissions on API 33+. The declarations below are kept only for
        API 24–32 devices where the legacy picker needs READ_EXTERNAL_STORAGE.
        On API 33+ they are ignored by the system.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        New-message push notifications (Android 13+). Without this the system drops
        every notification silently; the token still registers, so the failure looks
        like a server problem rather than a missing permission.
        MainActivity must still request it at runtime.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Package visibility (Android 11+): allows checking whether the companion
        WalkTalk app is installed so "Send Message" can open it, or fall back to
        Google Play when it is not.
    -->
    <queries>
        <package android:name="com.istaps.walktalk2" />
    </queries>

    <application
        android:name=".MookApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mook">
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!--
                SSO yetkilendirme isteği (ör. WalkTalk'tan): yalnızca doğrulanmış Android App Link.

                autoVerify="true": Android, kurulumda https://${ssoAppLinkHost}/.well-known/assetlinks.json
                dosyasını indirir ve Mook'un imza sertifikasıyla eşleşirse bu adresleri seçim
                penceresi göstermeden yalnızca Mook'a açar. Başka bir uygulama aynı adresi
                kaydetse bile isteği ele geçiremez.

                Eski "mook://authorize" özel şeması bilinçli olarak kaldırıldı: özel şemalar
                doğrulanamaz ve herhangi bir uygulama tarafından kaydedilebilir.

                Not: Bu filtre gelen isteğin kaynağını KANITLAMAZ; dışa açık bir Activity'ye açık
                (explicit) Intent ile sahte parametre gönderilebilir. İstemci, redirect_uri ve
                state doğrulaması bu yüzden VerifyAuthCallbackUseCase içinde yapılır.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${ssoAppLinkHost}"
                    android:path="/sso/authorize" />
            </intent-filter>
        </activity>
    </application>

</manifest>
