rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Versiyon kontrolü için herkese açık okuma — sadece settings/app_info belgesi
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // FIRESTORE GÜVENLİK TEMELİ — users/{uid}
    //
    // `users` koleksiyonu WalkTalk ile ORTAKTIR; bu yüzden create kuralı katı bir izin
    // listesi (allowlist) yerine şu iki katmanı uygular:
    //   1. Sunucuya ait alanlar (serverOwnedUserKeys) istemci tarafından ne OLUŞTURULABİLİR
    //      ne de DEĞİŞTİRİLEBİLİR. Bunlar yalnızca Cloud Functions (Admin SDK) ile yazılır ve
    //      `syncPublicProfile` aracılığıyla public_profiles'a yansır — sahte `verified`,
    //      sonsuz `boostUntil`, `incognito` ya da sınırsız oda listesi bu yüzden enjekte
    //      edilemez.
    //   2. Bilinen istemci alanları, varsa, tip ve boyut açısından doğrulanır
    //      (isValidUserCreation / hasValidClientFieldTypes).
    // İstemcinin `set(..., merge = true)` çağrıları belge yoksa CREATE olarak değerlendirilir;
    // her iki katman da bu yolu kapsar.
    // ---------------------------------------------------------------------
    function serverOwnedUserKeys() {
      return [
        // Oda/slot durumu: yalnızca switchRoom / closeRoomSlots.
        "roomLanguageCode", "roomLanguageCodes", "roomLastActiveAt", "roomSlots",
        // Ücretli ayrıcalıklar: yalnızca activateBoost / setIncognito / swipe.
        "boostUntil", "boostViewsGained", "incognito", "visibleTo",
        // Abonelik kademesi (Premium rozeti / Keşfet önceliği): yalnızca RevenueCat senkronizasyonu.
        "subscriptionTier",
        // Doğrulama rozeti: yalnızca sunucu/yönetici.
        "verified",
        // Kota gün sınırı: yalnızca updateTimeZone.
        "timeZone", "timeZoneChangedAt",
        // Discover'a giriş: yalnızca activateMookProfile.
        "isMookActive", "mookActivatedAt",
        // Moderasyon: yalnızca moderateUser.
        "isBanned", "banReason", "bannedAt"
      ];
    }

    // `keys`: doğrulanacak alan kümesi. Create'te belgenin tüm alanları, update'te YALNIZCA
    // değişen alanlar verilir — böylece WalkTalk'ın yazdığı ve Mook şemasına uymayan eski bir
    // alan, kullanıcının ilgisiz bir güncellemesini (ör. FCM jetonu) engellemez.
    function isOptionalString(data, keys, key, maxLength) {
      return !(key in keys) || (data[key] is string && data[key].size() <= maxLength);
    }
    function isOptionalNumber(data, keys, key) {
      return !(key in keys) || data[key] is number;
    }
    function isOptionalBool(data, keys, key) {
      return !(key in keys) || data[key] is bool;
    }
    function isOptionalList(data, keys, key, maxSize) {
      return !(key in keys) || (data[key] is list && data[key].size() <= maxSize);
    }

    // Mook istemcisinin yazdığı alanların tip/boyut doğrulaması. Listede olmayan alanlar
    // (ör. WalkTalk'a özgü alanlar) bilinçli olarak serbest bırakılır.
    function hasValidClientFieldTypes(data, keys) {
      return isOptionalString(data, keys, "email", 320)
        && isOptionalString(data, keys, "displayName", 100)
        && isOptionalString(data, keys, "bio", 2000)
        && isOptionalString(data, keys, "avatarUrl", 2048)
        && isOptionalString(data, keys, "languageCode", 16)
        && isOptionalString(data, keys, "countryCode", 8)
        && isOptionalString(data, keys, "gender", 32)
        && isOptionalNumber(data, keys, "birthDateMillis")
        && isOptionalNumber(data, keys, "lastActiveTimestamp")
        && isOptionalNumber(data, keys, "acceptedEulaAt")
        && isOptionalBool(data, keys, "acceptedEula")
        && isOptionalBool(data, keys, "discoverVisible")
        && isOptionalList(data, keys, "interests", 30)
        && isOptionalList(data, keys, "discoveryPhotos", 10)
        && isOptionalList(data, keys, "photoUrls", 10)
        && isOptionalList(data, keys, "fcmTokens", 100)
        && isOptionalList(data, keys, "blockedUsers", 5000);
    }

    // Yeni bir kullanıcı belgesi yalnızca sahibi tarafından, sunucuya ait hiçbir alan
    // İÇERMEDEN ve makul bir boyutla oluşturulabilir.
    function isValidUserCreation(uid) {
      let data = request.resource.data;
      return isMe(uid)
        && data.keys().size() <= 60
        && !data.keys().hasAny(serverOwnedUserKeys())
        && hasValidClientFieldTypes(data, data.keys());
    }

    // Güncellemede sunucuya ait alanlar değiştirilemez; tip doğrulaması yalnızca değişen
    // alanlara uygulanır.
    function isValidUserUpdate(uid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isMe(uid)
        && !changed.hasAny(serverOwnedUserKeys())
        && hasValidClientFieldTypes(data, changed);
    }

    match /users/{uid} {
      // Özel hesap belgesi: e-posta, doğum tarihi, FCM jetonları ve ödeme durumu Discover
      // tarafından listelenemez. Herkese açık keşif verisi sunucunun yönettiği
      // public_profiles projeksiyonundadır.
      allow get: if isMe(uid);
      allow list: if false;
      // `delete: if false` sayesinde create yalnızca GERÇEKTEN yeni bir belgede tetiklenir;
      // var olan bir yasağı silip yeniden oluşturarak atlatmak mümkün değildir.
      allow create: if isValidUserCreation(uid);
      allow update: if isValidUserUpdate(uid);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // public_profiles/{uid} — yalnızca syncPublicProfile (Admin SDK) yazar.
    //
    // GET: profil detayı (bildirim, eşleşme, beğendiklerim) için tek belge okumaya izin
    // verilir; gizli (incognito) profiller yalnızca daha önce beğendikleri kişilere açılır.
    //
    // LIST: Discover akışı sunucudadır (getDiscoverFeed); meşru istemci bu koleksiyonu
    // sorgulamaz. Değiştirilmiş bir istemcinin koleksiyonu kazımasını önlemek için ham bir
    // sorgu YALNIZCA şu kısıtları AÇIKÇA filtreliyorsa kabul edilir (kurallar sorgunun
    // kısıtlarını kanıtlayabilmelidir):
    //   - `isMookActive == true` ve `incognito == false`,
    //   - `languageCode == <kullanıcının aktif odası>` — Premium (freeRoam) hariç,
    //   - sayfa boyutu en fazla 20.
    // `request.app != null`: yalnızca geçerli App Check (Play Integrity) jetonu taşıyan
    // istemciler okuyabilir; konsolda Firestore için App Check "Enforce" da açılmalıdır.
    // ---------------------------------------------------------------------
    function callerUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kullanıcının şu an AKTİF odası (getDiscoverFeed ile aynı kural: Premium dışındaki
    // kullanıcılar yalnızca aktif odalarını görebilir).
    function callerActiveRoom() {
      return callerUserDoc().get("roomLanguageCode", "");
    }

    // Özgürce dolaşma (freeRoam) yalnızca Premium'a aittir. Önce Auth jetonundaki RevenueCat
    // talebine bakılır; yeni satın almada jeton bayat olabileceği için `customers/{uid}`
    // belgesi yedek olarak okunur (sunucudaki resolveTierFor ile aynı sıra).
    function callerHasFreeRoam() {
      return "premium" in request.auth.token.get("revenueCatEntitlements", [])
        || "premium" in get(/databases/$(database)/documents/customers/$(request.auth.uid))
             .data.get("revenueCatEntitlements", []);
    }

    match /public_profiles/{uid} {
      allow get: if signedIn() && request.app != null
        && (resource.data.incognito != true || request.auth.uid in resource.data.get("visibleTo", []));

      allow list: if signedIn() && request.app != null
        && request.query.limit <= 20
        && resource.data.isMookActive == true
        && resource.data.incognito == false
        && (resource.data.languageCode == callerActiveRoom() || callerHasFreeRoam());

      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // WalkMatch: kaydırma kayıtları. Doküman kimliği "{fromUserId}_{toUserId}".
    // ---------------------------------------------------------------------
    match /interactions/{interactionId} {
      function validInteraction(data) {
        return data.fromUserId == request.auth.uid
          && data.toUserId is string
          && data.toUserId != request.auth.uid
          && data.type in ["like", "pass"]
          && data.timestamp is number;
      }

      // get: Karşılıklı beğeni kontrolü, ters dokümanı ("{onlar}_{ben}") okur.
      // Bu yüzden bana yönelen kaydı da okuyabilmeliyim. Üçüncü kişiler
      // arasındaki kayıtlar iki koşula da uymadığı için kapalı kalır.
      //
      // resource == null: karşı taraf beni henüz kaydırmadıysa ters doküman
      // yoktur. Var olmayan dokümanı okumaya izin verilmezse "like" akışındaki
      // eşleşme kontrolü PERMISSION_DENIED alır. Yokluğu görmek veri sızdırmaz.
      allow get: if signedIn() && (
        resource == null ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );

      // list: Yalnızca kendi kaydırmalarım. Sorgu fromUserId'ye göre
      // filtrelenmek zorunda; aksi halde Firestore statik analizi reddeder.
      allow list: if signedIn() && resource.data.fromUserId == request.auth.uid;

      // swipe callable validates blocks, idempotency and quota transactionally. Any direct
      // client write would bypass those monetization controls.
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // WalkMatch: eşleşmeler. Doküman kimliği iki uid'in sıralanmış hali.
    // Eşleşmeyi istemci yazdığı için, kural iki tarafın da "like" kaydının
    // gerçekten var olmasını şart koşar — yoksa herkes istediğiyle sahte
    // eşleşme yaratabilirdi.
    // ---------------------------------------------------------------------
    match /matches/{matchId} {
      function otherUid(users) {
        return users[0] == request.auth.uid ? users[1] : users[0];
      }

      // Her iki doküman da yoksa get() null döner ve null.type hata fırlatır;
      // bu yüzden önce ikisinin de varlığı doğrulanır.
      function likedEachOther(other) {
        let mine = /databases/$(database)/documents/interactions/$(request.auth.uid + '_' + other);
        let theirs = /databases/$(database)/documents/interactions/$(other + '_' + request.auth.uid);
        return exists(mine) && exists(theirs)
          && get(mine).data.type == "like"
          && get(theirs).data.type == "like";
      }

      function validMatch(data) {
        return data.users is list
          && data.users.size() == 2
          && request.auth.uid in data.users
          && data.users[0] != data.users[1]
          && data.timestamp is number
          // Kimlik, iki uid'in birleşiminden başka bir şey olamaz.
          && (matchId == data.users[0] + '_' + data.users[1] ||
              matchId == data.users[1] + '_' + data.users[0])
          && likedEachOther(otherUid(data.users));
      }

      // Şu an istemci eşleşmeleri sorgulamıyor; ileride listelemek için
      // sorgu whereArrayContains("users", uid) ile filtrelenmelidir.
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      allow create, update, delete: if false;
    }

    match /usage/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    match /customers/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Gereksinim (Altyapı): `onRevenueCatEvent` webhook'unun idempotency koruması için
    // durum belgeleri. Yalnızca Cloud Function (Admin SDK, kuralları atlar) okur/yazar —
    // istemcinin bu koleksiyona dokunmasının HİÇBİR meşru senaryosu yoktur.
    match /processed_revenuecat_events/{eventId} {
      allow read, write: if false;
    }

    // Plan sınırları (Tek Doğruluk Kaynağı): oturum açmış her istemci okur, YALNIZCA sunucu yazar.
    match /config/plans {
      allow read: if signedIn();
      allow write: if false;
    }

    // Kötüye kullanım işaretleri ve olay geçmişi: yalnızca Cloud Functions (Admin SDK).
    // İşaretlenen kullanıcı dahil hiçbir istemci okuyamaz ya da yazamaz.
    match /abuse_flags/{uid} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Yaş yenileme zamanı (doğum günü türevi): yalnızca sunucu; herkese açık profile sızmaz.
    match /private_profile_meta/{uid} {
      allow read, write: if false;
    }

    match /profileViews/{viewId} {
      allow read, write: if false;
    }

    match /ssv_transactions/{transactionId} {
      allow read, write: if false;
    }

    match /liked_me_unlocks/{unlockId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Okundu bilgisi (Premium ayrıcalığı): `read_receipts/{chatId}_{readerUid}`.
    // - YAZMA: yalnızca okuyan kişinin kendisi, yalnızca katılımcısı olduğu sohbet için ve
    //   gelecekteki bir zamanla değil (en fazla 1 dk saat kayması toleransı).
    // - OKUMA: yalnızca sohbetin DİĞER katılımcısı ve yalnızca Premium yetkisi (Firebase Auth
    //   özel talebi `revenueCatEntitlements`) varsa. Premium olmayan kullanıcı karşı tarafın
    //   okuyup okumadığını göremez.
    match /read_receipts/{receiptId} {
      function chatUsers(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }

      function isPremiumCaller() {
        return "premium" in request.auth.token.get("revenueCatEntitlements", []);
      }

      // Henüz yazılmamış bir okundu bilgisini dinlemek (resource == null) hiçbir veri
      // sızdırmaz; Premium dinleyicinin "izin reddedildi" hatası almaması için izinlidir.
      allow get: if signedIn() && isPremiumCaller() && (
        resource == null || (
          request.auth.uid != resource.data.readerUid
          && request.auth.uid in chatUsers(resource.data.chatId)
        )
      );

      allow list: if false;

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(["chatId", "readerUid", "lastReadAt"])
        && request.resource.data.readerUid == request.auth.uid
        && request.resource.data.chatId is string
        && receiptId == request.resource.data.chatId + "_" + request.auth.uid
        && request.auth.uid in chatUsers(request.resource.data.chatId)
        && request.resource.data.lastReadAt is int
        && request.resource.data.lastReadAt <= request.time.toMillis() + 60000;

      allow delete: if false;
    }

    match /chats/{chatId} {
      // READ (tekil + query):
      // `request.auth.uid in resource.data.users` ifadesi,
      // `whereArrayContains("users", uid)` ile yapılan sorgularda
      // Firestore'un statik analizi tarafından kanıtlanabilir.
      // `resource.data.users is list` eklenmesi statik analizde
      // sorun çıkardığı için kaldırıldı.
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      // CREATE / UPDATE: Sohbet dokümanını yalnızca `sendMessage` callable'ı
      // (Admin SDK) yazar; Admin SDK kuralları atladığı için buraya izin
      // vermeye gerek yok. Eski kural "yeni veriye kendi uid'ini koyan herkes"e
      // yazma hakkı veriyordu: A, kendini `users` dizisine ekleyerek B ile C
      // arasındaki sohbeti ezebiliyordu. Tek istisna okundu bilgisi — kullanıcı
      // yalnızca kendi sayacını sıfırlayabilir.
      allow create: if false;

      // İlk mesajdan önce `unreadCounts` alanı yoktur; get(...) varsayılanı
      // olmadan diff() hata fırlatıp yazmayı reddederdi.
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["unreadCounts"])
        && request.resource.data.unreadCounts[request.auth.uid] == 0
        // Karşı tarafın sayacına dokunulamaz.
        && request.resource.data.unreadCounts
             .diff(resource.data.get("unreadCounts", {})).affectedKeys()
             .hasOnly([request.auth.uid]);

      allow delete: if false;

      match /messages/{messageId} {
        // get() null döner ve null.users hata fırlatır — önce exists() kontrolü zorunlu.
        function chatExists() {
          return exists(/databases/$(database)/documents/chats/$(chatId));
        }
        function userInChat() {
          return chatExists()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        }

        // Chat henüz yoksa (yeni sohbet) mesaj listesi zaten boş — okumaya izin ver.
        // Chat varsa kullanıcı üye olmalı.
        allow read: if signedIn() && (userInChat() || !chatExists());

        // Mesajlar yalnızca `sendMessage` callable'ı üzerinden yazılır. İstemciye
        // doğrudan yazma hakkı verilirse eşleşme kontrolü, hız sınırı, çeviri ve
        // bildirim — dördü birden — atlanır.
        allow create, update, delete: if false;
      }
    }

    match /public_chats/{languageCode} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      function isParticipant() {
        return signedIn() && (
          resource.data.callerUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid
        );
      }

      function validStatus(status) {
        return status in ["calling", "ringing", "accepted", "rejected", "ended"];
      }

      allow read: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.status == "calling"
        && request.resource.data.timestamp is timestamp;

      allow update: if signedIn()
        && isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && validStatus(request.resource.data.status)
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.timestamp == resource.data.timestamp;

      allow delete: if false;
    }

    match /posts/{postId} {
      // WalkTalk's established Android client writes the author as `uid`; Mook's
      // newer surface uses `authorUid`.  Keep both schemas readable and writable
      // by their owner while the clients share this collection.
      function isPostOwner(data) {
        return (data.uid is string && data.uid == request.auth.uid)
          || (data.authorUid is string && data.authorUid == request.auth.uid);
      }

      allow read: if signedIn() && (resource.data.isPublic == true || isPostOwner(resource.data));
      allow create: if signedIn() && isPostOwner(request.resource.data);
      allow update: if signedIn() && (
        isPostOwner(resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likedBy", "likeCount"])
      );
      allow delete: if signedIn() && isPostOwner(resource.data);
    }

    match /stories/{storyId} {
      function storyAuthorUid() {
        return (resource.data.uid is string) ? resource.data.uid : resource.data.authorUid;
      }

      function isStoryOwner() {
        return signedIn() && storyAuthorUid() == request.auth.uid;
      }

      // list (koleksiyon sorgusu): istemci zaten arkadaş UID'leriyle filtreler
      allow list: if signedIn();

      // get (tek doküman okuma): sahip veya arkadaş olmalı
      allow get: if signedIn() && (
        isStoryOwner() ||
        request.auth.uid in get(/databases/$(database)/documents/users/$(storyAuthorUid())).data.get("friends", [])
      );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.photoUrl is string
        && request.resource.data.timestamp is timestamp
        && request.resource.data.viewers is list;

      allow update: if isStoryOwner() || (
        signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["viewers"])
        && request.resource.data.viewers is list
        && request.auth.uid in request.resource.data.viewers
      );

      allow delete: if isStoryOwner();
    }

    match /reports/{reportId} {
      // Yalnızca Cloud Function (Admin SDK) okuyabilir ve güncelleyebilir
      allow read, update, delete: if false;
      // Kimlik doğrulamalı kullanıcılar rapor oluşturabilir
      // (içerik doğrulaması Cloud Function içinde yapılır)
      allow create: if signedIn();
    }
  }
}
