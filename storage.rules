rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /public_chat_images/{languageCode}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /stories/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------
    // WalkMatch: profil fotoğrafları (avatar + Discover galerisi).
    // Yol, AuthRepositoryImpl'deki "users/$userId/$fileName" ile birebir.
    // Okuma herkese açık değil ama giriş yapan herkese açık: Discover ve
    // profil ekranı başka kullanıcıların fotoğraflarını göstermek zorunda.
    // Yazma yalnızca dosyanın sahibinde.
    // -------------------------------------------------------------------
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
